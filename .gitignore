# Filament Flex Fields — gitignore
#
# Ignored: dependencies, tool caches/output, IDE/OS junk, secrets.
#
# Intentionally TRACKED (do not add here):
#   - phpunit.xml, phpstan.neon, scripts/     — build & QA tooling
#   - tests/                                  — PHPUnit & Pest suite
#   - resources/js/, resources/css/           — frontend source (dist/ is pre-built)
#   - package.json, package-lock.json         — Node build toolchain
#   - src/Support/Playground/, FlexFieldsPlayground page — optional dev UI in the package
#   - resources/dist/                         — pre-built CSS/JS for consumers without Node

# Dependencies
/vendor/
/node_modules/

# PHPUnit / Pest
.phpunit.cache/
.phpunit.result.cache
/vendor/pestphp/pest/.temp/

# Coverage
/coverage/
*.cov
.nyc_output/

# PHPStan / build
/build/
phpstan.neon.dist.local

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs & environment
*.log
.env
.env.*
!.env.example

# npm
.npm-cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Playwright / Testing
/test-results/
/reference/
/bin/
/playwright-report/

# Local Dev
/DEMO/
/scratch/
/.reference/

# Ad-hoc local debug scripts dumped in package root (never publish)
/test-*.mjs
/test-*.js
/test-*.png
/fix-tests*.php
/remove_soft_radius.php

# Maintainer-only docs — not for public GitHub (customer docs live in docs/)
/DEVELOPMENT.md
/COMPONENTS.md
/composer.lock
